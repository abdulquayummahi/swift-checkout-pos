<!-- Project: SwiftCheckoutPOS.UI -->
<!-- File: Views/Report/ZReport.cshtml -->
@model SwiftCheckoutPOS.BLL.DTOs.ZReportDTO

@{
    ViewData["Title"] = "End of Day Z-Report";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0">Z-Report / Drawer Reconciliation</h3>

        <!-- Date Selection Form -->
        <form asp-action="ZReport" method="get" class="d-flex align-items-center bg-white p-2 rounded shadow-sm border">
            <label for="date" class="fw-bold text-muted me-2 text-nowrap">Report Date:</label>
            <input type="date" name="date" id="date" class="form-control form-control-sm me-2" value="@Model.ReportDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
        </form>
    </div>

    <div class="row g-4">
        <!-- Core Financials -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold py-3">
                    Financial Summary
                </div>
                <div class="card-body bg-light p-4">
                    <div class="row mb-4 border-bottom pb-3">
                        <div class="col-6">
                            <span class="text-muted fw-bold d-block">Total Transactions</span>
                            <span class="fs-4 fw-bold">@Model.TotalTransactions</span>
                        </div>
                        <div class="col-6 text-end">
                            <span class="text-muted fw-bold d-block">Gross Revenue</span>
                            <span class="fs-3 fw-bold text-success">@Model.GrossRevenue.ToString("C")</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-2 fs-5">
                        <span class="fw-bold">Net Sales</span>
                        <span class="font-monospace">@Model.NetRevenue.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 fs-5 text-danger">
                        <span class="fw-bold">Tax Collected</span>
                        <span class="font-monospace">@Model.TotalTaxCollected.ToString("C")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tender Breakdown for Drawer -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100 border-primary">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    Tender Breakdown
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <span class="d-block text-muted fw-bold small text-uppercase">Expected Cash in Drawer</span>
                        <span class="fs-4 fw-bold text-dark">@Model.CashTotal.ToString("C")</span>
                    </div>
                    <div class="mb-3">
                        <span class="d-block text-muted fw-bold small text-uppercase">Credit / Debit Card</span>
                        <span class="fs-5 fw-bold text-dark">@Model.CardTotal.ToString("C")</span>
                    </div>
                    <div class="mb-3">
                        <span class="d-block text-muted fw-bold small text-uppercase">Mobile Wallet (M-FS)</span>
                        <span class="fs-5 fw-bold text-dark">@Model.MobileWalletTotal.ToString("C")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-end">
        <button class="btn btn-secondary fw-bold px-4 shadow-sm" onclick="window.print()">PRINT REPORT (CTRL+P)</button>
    </div>
</div>