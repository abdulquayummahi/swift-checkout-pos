@model SwiftCheckoutPOS.BLL.DTOs.RefundLookupDTO
@{
    ViewData["Title"] = "Refunds and voids";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Refunds and voids</h1>
        <p class="page-sub">Find the sale by its receipt number. Refunds are allowed for 7 days; a sale can be voided within 5 minutes.</p>
    </div>
</div>

<form asp-action="Lookup" method="post" id="lookupForm" class="till-search mb-4" style="max-width:none" role="search">
    @Html.Icon("receipt")
    <input type="text" name="receiptNumber" id="barcodeInput" placeholder="Scan the receipt barcode or type the receipt number" autocomplete="off" autofocus required aria-label="Receipt number" class="font-monospace" />
    <kbd>F2</kbd>
    <button type="submit" class="btn btn-primary btn-sm">Find sale</button>
</form>

@if (Model == null)
{
    <div class="card"><div class="empty">
        @Html.Icon("refund")
        <div class="empty-title">No sale selected</div>
        <div class="small">The receipt number is printed at the top of the receipt, for example SCP-20261104-0001.</div>
    </div></div>
}
else
{
    var status = Model.OrderStatus;
    var statusClass = Model.CanRefund ? "is-ok" : status is "Refunded" or "Voided" ? "is-bad" : "is-warn";
    <div class="card">
        <div class="panel-head flex-wrap">
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h2 class="h4 mb-0 font-monospace">@Model.ReceiptNumber</h2>
                    <span class="status @statusClass">@status</span>
                </div>
                <div class="text-muted small mt-1">
                    Sold @Model.SaleDate.ToString("dd MMM yyyy, HH:mm") · paid by @Model.PaymentMethod
                    @if (!string.IsNullOrEmpty(Model.CustomerName)) { <span> · @Model.CustomerName</span> }
                </div>
            </div>
            <div class="d-flex gap-4 text-end">
                <div><div class="small text-muted">Sale total</div><div class="num fs-4 fw-semibold">@Html.Money(Model.TotalAmount)</div></div>
                <div><div class="small text-muted">Already refunded</div><div class="num fs-4 fw-semibold @(Model.RefundedAmount > 0 ? "text-danger" : "")">@Html.Money(Model.RefundedAmount)</div></div>
            </div>
        </div>
        @if (Model.RefundBlockedReason != null)
        {
            <div class="alert alert-warning m-3 mb-0">@Html.Icon("alert") <span>@Model.RefundBlockedReason</span></div>
        }
        <form asp-action="ConfirmRefund" method="post" id="refundForm" class="m-0" data-confirm="Refund the selected items?" data-confirm-text="Returned items go back into stock unless you mark them Damaged. Money goes back to the original payment methods." data-confirm-ok="Refund" data-confirm-danger>
            <input type="hidden" name="receiptNumber" value="@Model.ReceiptNumber" />
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Product</th><th class="text-end">Paid for line</th><th class="text-end">Sold</th><th class="text-end">Can still refund</th><th class="text-end" style="width:120px">Refund qty</th><th style="width:190px">Returned goods</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];
                            <tr>
                                <td class="fw-semibold">@line.ProductName</td>
                                <td class="text-end num">@line.LineNet.ToString("N2")</td>
                                <td class="text-end num">@line.Quantity</td>
                                <td class="text-end num">@line.Remaining</td>
                                <td class="text-end">
                                    <input type="hidden" name="lines[@i].SaleItemId" value="@line.SaleItemId" />
                                    <input type="number" name="lines[@i].Quantity" min="0" max="@line.Remaining" value="@(Model.CanRefund ? line.Remaining : 0)" aria-label="Refund quantity for @line.ProductName"
                                           class="form-control form-control-sm text-end num ms-auto" style="width:88px" @(Model.CanRefund && line.Remaining > 0 ? "" : "disabled") />
                                </td>
                                <td>
                                    <select name="lines[@i].Disposition" class="form-select form-select-sm" aria-label="Returned goods for @line.ProductName" @(Model.CanRefund ? "" : "disabled")>
                                        <option value="Restock">Back into stock</option>
                                        <option value="Damaged">Damaged, write off</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.CanRefund)
            {
                <div class="panel-body border-top d-flex gap-3 align-items-end flex-wrap">
                    <div class="flex-grow-1" style="min-width:240px">
                        <label class="form-label" for="refundReason">Reason (optional)</label>
                        <input id="refundReason" type="text" name="reason" maxlength="200" class="form-control" placeholder="For example: wrong size, expired" />
                    </div>
                    <button type="submit" class="btn btn-danger btn-lg" id="refundBtn" data-busy="Refunding…">@Html.Icon("refund") Refund selected <kbd>F12</kbd></button>
                    <div class="help w-100">Any unpaid Due on this sale is cancelled first; the rest is paid back to the original payment methods, cash rounded to whole taka.</div>
                </div>
            }
        </form>
        @if (Model.CanVoid)
        {
            <form asp-action="VoidSale" method="post" class="panel-body border-top d-flex gap-3 align-items-end flex-wrap" data-confirm="Void the whole sale?" data-confirm-text="All stock goes back and all money is given back. The sale stays in the records as Voided." data-confirm-ok="Void sale" data-confirm-danger>
                <input type="hidden" name="receiptNumber" value="@Model.ReceiptNumber" />
                <div class="flex-grow-1" style="min-width:240px">
                    <label class="form-label" for="voidReason">Reason for the void</label>
                    <input id="voidReason" type="text" name="reason" maxlength="200" class="form-control" required placeholder="Required" />
                </div>
                <button type="submit" class="btn btn-outline-danger btn-lg">@Html.Icon("ban") Void the whole sale</button>
                <div class="help w-100">Only possible in the first 5 minutes after the sale.</div>
            </form>
        }
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('keydown', function (e) {
            if (document.querySelector('.modal.show')) return;
            if (e.key === 'F2') { e.preventDefault(); var i = document.getElementById('barcodeInput'); i.focus(); i.select(); }
            if (e.key === 'F12') { e.preventDefault(); var b = document.getElementById('refundBtn'); if (b && !b.disabled) document.getElementById('refundForm').requestSubmit(b); }
        });
    </script>
}
