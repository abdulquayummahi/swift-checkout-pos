@model SwiftCheckoutPOS.BLL.DTOs.DashboardMetricsDTO
@{
    ViewData["Title"] = "Overview";
    var filter = (string?)ViewBag.CurrentFilter ?? "today";
    var periods = new (string Value, string Text)[] { ("today", "Today"), ("7days", "7 days"), ("30days", "30 days"), ("6months", "6 months"), ("1year", "1 year"), ("lifetime", "All time") };
    var periodText = periods.FirstOrDefault(p => p.Value == filter).Text ?? "Today";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Overview</h1>
        <p class="page-sub">Sales and profit for @(filter == "today" ? "today" : filter == "lifetime" ? "all time" : "the last " + periodText.ToLowerInvariant()).</p>
    </div>
    <div class="page-actions">
        <nav class="segmented" aria-label="Period">
            @foreach (var p in periods)
            {
                <a asp-action="Index" asp-route-filter="@p.Value" class="@(filter == p.Value ? "is-active" : "")" aria-current="@(filter == p.Value ? "true" : null)">@p.Text</a>
            }
        </nav>
    </div>
</div>

<div class="figures mb-4">
    <div class="figure"><div class="figure-label">Revenue</div><div class="figure-value">@Html.Money(Model.TotalRevenue)</div></div>
    <div class="figure @(Model.EstimatedProfit >= 0 ? "is-good" : "is-bad")"><div class="figure-label">Estimated profit</div><div class="figure-value">@Html.Money(Model.EstimatedProfit)</div><div class="figure-note">Revenue minus cost at sale</div></div>
    <div class="figure"><div class="figure-label">Discounts given</div><div class="figure-value">@Html.Money(Model.TotalDiscounts)</div></div>
    <div class="figure"><div class="figure-label">Sales</div><div class="figure-value">@Model.TotalOrders.ToString("N0")</div></div>
    <div class="figure"><div class="figure-label">Items sold</div><div class="figure-value">@Model.ProductsSold.ToString("N0")</div></div>
    <div class="figure"><div class="figure-label">New customers</div><div class="figure-value">@Model.NewCustomers.ToString("N0")</div></div>
</div>

<div class="row g-3">
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="panel-head"><h2>Best sellers</h2><span class="small text-muted">by units</span></div>
            <div class="panel-body">
                @if (!Model.TopProducts.Any())
                {
                    <div class="empty py-3">@Html.Icon("products")<div class="empty-title">No sales in this period</div></div>
                }
                @foreach (var product in Model.TopProducts)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between gap-2 small mb-1">
                            <span class="fw-semibold text-truncate" title="@product.ProductName">@product.ProductName</span>
                            <span class="num text-muted text-nowrap">@product.QuantitySold @(product.QuantitySold == 1 ? "unit" : "units")</span>
                        </div>
                        <div class="bar"><span style="width:@product.Percentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="panel-head">
                <h2>Recent sales</h2>
                <div class="d-flex gap-2">
                    <a asp-controller="Refund" asp-action="Index" class="btn btn-ghost btn-sm">@Html.Icon("refund") Refund a sale</a>
                    <a asp-controller="Shift" asp-action="Index" class="btn btn-ghost btn-sm">@Html.Icon("shift") Till shift</a>
                </div>
            </div>
            @if (!Model.RecentTransactions.Any())
            {
                <div class="empty">@Html.Icon("receipt")<div class="empty-title">No sales yet in this period</div><div class="small">Completed sales from the till appear here.</div></div>
            }
            else
            {
                <div class="table-responsive" style="max-height:460px">
                    <table class="table table-hover">
                        <thead class="sticky-top"><tr><th>Receipt</th><th>Time</th><th>Paid by</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var txn in Model.RecentTransactions)
                            {
                                var statusClass = txn.OrderStatus switch { "Refunded" or "Voided" => "is-bad", "PartiallyRefunded" or "Held" => "is-warn", _ => "is-ok" };
                                <tr>
                                    <td class="font-monospace small">@(txn.OrderStatus is "Held" or "Resumed" ? "Held order" : txn.ReceiptNumber)</td>
                                    <td class="text-muted small text-nowrap">@txn.SaleDate.ToString("dd MMM, HH:mm")</td>
                                    <td>@(txn.PaymentMethod == "Pending" ? "–" : txn.PaymentMethod)</td>
                                    <td><span class="status @statusClass">@(txn.OrderStatus == "PartiallyRefunded" ? "Part refunded" : txn.OrderStatus)</span></td>
                                    <td class="text-end num fw-semibold">@txn.TotalAmount.ToString("N2")</td>
                                    <td class="actions"><button class="btn btn-ghost btn-sm" data-bs-toggle="modal" data-bs-target="#modal-@txn.SaleId">Details</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@foreach (var txn in Model.RecentTransactions)
{
    <div class="modal fade" id="modal-@txn.SaleId" tabindex="-1" aria-labelledby="title-@txn.SaleId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title font-monospace" id="title-@txn.SaleId">@txn.ReceiptNumber</h2>
                        <div class="small text-muted">@txn.SaleDate.ToString("dd MMM yyyy, HH:mm") · @txn.PaymentMethod · @(string.IsNullOrEmpty(txn.CustomerName) ? "Walk-in customer" : txn.CustomerName)</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <table class="table">
                        <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Line total</th></tr></thead>
                        <tbody>
                            @foreach (var item in txn.SaleItems)
                            {
                                <tr><td>@item.ProductName</td><td class="text-end num">@item.Quantity</td><td class="text-end num">@item.LineTotal.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer justify-content-between">
                    <div class="small text-muted">Discount @Html.Money(txn.DiscountAmount) · Profit @Html.Money(txn.EstimatedProfit)</div>
                    <div class="num fs-4 fw-semibold">@Html.Money(txn.TotalAmount)</div>
                </div>
            </div>
        </div>
    </div>
}
