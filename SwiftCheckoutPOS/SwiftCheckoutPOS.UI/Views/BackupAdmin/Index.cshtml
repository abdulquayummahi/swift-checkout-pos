<!-- Project: SwiftCheckoutPOS.UI -->
<!-- File: Views/BackupAdmin/Index.cshtml -->
@model SwiftCheckoutPOS.BLL.DTOs.BackupPageDTO
@{
    ViewData["Title"] = "Backup & Recovery";
    var config = Model.Config;
    var status = Model.Status;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark m-0">Backup &amp; Recovery</h2>
    <form asp-action="TriggerManualBackup" method="post" class="m-0">
        <button type="submit" class="btn btn-warning fw-bold px-4 shadow-sm text-dark">Back up now</button>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fw-bold shadow-sm border-0 py-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold shadow-sm border-0 py-2">@TempData["Error"]</div>
}
@foreach (var warning in Model.Warnings)
{
    <div class="alert alert-warning border-0 shadow-sm py-2 mb-2">@warning</div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-dark text-white py-3"><h6 class="mb-0 fw-bold">Settings</h6></div>
            <div class="card-body p-4 bg-light">
                <form asp-action="SaveConfiguration" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="targetDirectory">Backup folder</label>
                        <input type="text" id="targetDirectory" name="targetDirectory" class="form-control font-monospace" value="@config.TargetDirectory" placeholder="@Model.EffectiveTarget" />
                        <small class="text-muted d-block mt-1">Leave empty for the default: <span class="font-monospace">@Model.EffectiveTarget</span>. Must be outside the program folder.</small>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="isAutoBackupEnabled" name="isAutoBackupEnabled" value="true" @(config.IsAutoBackupEnabled ? "checked" : "") />
                        <label class="form-check-label fw-bold" for="isAutoBackupEnabled">Automatic daily backup (runs late if the PC was off)</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="autoBackupTime">Daily time</label>
                        <input type="time" id="autoBackupTime" name="autoBackupTime" class="form-control w-50" value="@config.AutoBackupTime.ToString(@"hh\:mm")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="usbCopyDirectory">USB drive folder (optional)</label>
                        <input type="text" id="usbCopyDirectory" name="usbCopyDirectory" class="form-control font-monospace" value="@config.UsbCopyDirectory" placeholder="E:\" />
                        <small class="text-muted d-block mt-1">When this drive is plugged in, every new backup is also copied there.</small>
                    </div>
                    <button type="submit" class="btn btn-primary fw-bold w-100">Save settings</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-dark text-white py-3"><h6 class="mb-0 fw-bold">USB copy (daily, keep the drive away from this PC)</h6></div>
            <div class="card-body p-4 bg-light">
                <p class="mb-2">Last copy: <strong>@(status.LastUsbCopyAt?.ToString("dd MMM yyyy HH:mm") ?? "never")</strong> @(status.LastUsbCopySet is null ? "" : "(" + status.LastUsbCopySet + ")")</p>
                @if (status.LastUsbError is not null) { <p class="text-danger mb-2">Last error: @status.LastUsbError</p> }
                <form asp-action="CopyToUsb" method="post" class="d-flex gap-2">
                    <input type="text" name="usbDirectory" class="form-control font-monospace" value="@config.UsbCopyDirectory" placeholder="E:\" aria-label="USB folder" />
                    <button type="submit" class="btn btn-outline-dark fw-bold text-nowrap">Copy newest</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-dark text-white py-3"><h6 class="mb-0 fw-bold">Restore</h6></div>
            <div class="card-body p-4 bg-light small">
                <p class="mb-2">Last restore drill: <strong>@(status.LastDrillAt?.ToString("dd MMM yyyy HH:mm") ?? "never")</strong> — @(status.LastDrillResult ?? "not run yet")</p>
                <p class="mb-1">Restoring replaces today's data, so it is done by the owner with the program stopped, in an administrator console in the program folder:</p>
                <ul class="mb-0">
                    <li><span class="font-monospace">SwiftCheckoutPOS.UI.exe --restore-drill</span> — monthly test (PR-Q84); does not change live data.</li>
                    <li><span class="font-monospace">SwiftCheckoutPOS.UI.exe --restore &lt;backup name&gt;</span> — real restore; makes a safety backup first.</li>
                </ul>
                <p class="mt-2 mb-0">Full steps: DATA_RECOVERY_PLAN.md.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-dark text-white py-3"><h6 class="mb-0 fw-bold">Backups in @Model.EffectiveTarget</h6></div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 640px; overflow-y: auto;">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="py-3 ps-4">Made</th>
                                <th class="py-3">Name</th>
                                <th class="py-3">Kind</th>
                                <th class="py-3 text-end">Size</th>
                                <th class="py-3">Check</th>
                                <th class="py-3 text-center pe-4">Download</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white">
                            @if (!Model.History.Any())
                            {
                                <tr><td colspan="6" class="text-center py-5 text-muted fw-bold">No backups yet.</td></tr>
                            }
                            @foreach (var set in Model.History)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">@set.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="font-monospace small">@set.SetName</td>
                                    <td>@set.Kind</td>
                                    <td class="text-end">@(set.SizeBytes > 0 ? set.SizeMB + " MB" : "-")</td>
                                    <td>
                                        @if (set.Verified) { <span class="badge bg-success">Verified</span> }
                                        else { <span class="badge bg-danger" title="@set.Error">@(set.Legacy ? "Not verified" : "Failed")</span> }
                                    </td>
                                    <td class="text-center pe-4 text-nowrap">
                                        @if (set.Verified || set.Legacy)
                                        {
                                            <a asp-action="DownloadBackup" asp-route-fileName="@set.BackupFile" class="btn btn-sm btn-outline-primary fw-bold">.bak</a>
                                        }
                                        @if (set.FilesArchive is not null)
                                        {
                                            <a asp-action="DownloadBackup" asp-route-fileName="@set.FilesArchive" class="btn btn-sm btn-outline-secondary fw-bold">files</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
