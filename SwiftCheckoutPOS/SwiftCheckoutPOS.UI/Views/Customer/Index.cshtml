@model IEnumerable<SwiftCheckoutPOS.BLL.DTOs.CustomerProfileDTO>
@{
    ViewData["Title"] = "Customers";
    var canFin = (bool)ViewBag.CanViewFinancials;
    var sort = (string?)ViewBag.SortOrder;
    var pager = ViewBag.Page as SwiftCheckoutPOS.UI.Models.PageInfo;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Customers</h1>
        <p class="page-sub">Registered customers can buy on Due and see their purchase history.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCustomerModal" id="newCustomerBtn">@Html.Icon("user-plus") Add customer <kbd>Ins</kbd></button>
    </div>
</div>

<form asp-action="Index" method="get" id="filterForm" class="d-flex gap-2 flex-wrap mb-3" role="search">
    <div class="input-group flex-grow-1" style="max-width:520px">
        <span class="input-group-text">@Html.Icon("search")</span>
        <input type="search" name="searchQuery" id="searchInput" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search by name, phone or address" autocomplete="off" aria-label="Search customers" />
        <span class="input-group-text"><kbd>F2</kbd></span>
    </div>
    <select name="sortOrder" id="sortOrder" class="form-select" style="width:auto" aria-label="Sort">
        <option value="" selected="@(string.IsNullOrEmpty(sort))">Name A to Z</option>
        <option value="spent_desc" selected="@(sort == "spent_desc")">Spent most</option>
        <option value="spent_asc" selected="@(sort == "spent_asc")">Spent least</option>
        @if (canFin)
        {
            <option value="profit_desc" selected="@(sort == "profit_desc")">Most profit</option>
            <option value="profit_asc" selected="@(sort == "profit_asc")">Least profit</option>
        }
        <option value="discount_desc" selected="@(sort == "discount_desc")">Most discount</option>
        <option value="refunded_desc" selected="@(sort == "refunded_desc")">Most refunded</option>
    </select>
    @if (!string.IsNullOrEmpty((string?)ViewBag.SearchQuery) || !string.IsNullOrEmpty(sort))
    {
        <a href="@Url.Action("Index", "Customer")" class="btn btn-ghost">@Html.Icon("x") Clear</a>
    }
</form>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Address</th>
                    <th class="text-end">Purchases</th>
                    <th class="text-end">Spent</th>
                    @if (canFin) { <th class="text-end">Profit</th> }
                    <th class="text-end">Discounts</th>
                    <th class="text-end">Refunded</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8"><div class="empty">@Html.Icon("customers")<div class="empty-title">No customers found</div><div class="small">Add a customer here or from the till.</div></div></td></tr>
                }
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="avatar" aria-hidden="true">@UiHelpers.Initials(customer.FullName)</span>
                                <div class="min-w-0">
                                    <a asp-action="Details" asp-route-id="@customer.CustomerId" class="fw-semibold text-body text-decoration-none">@customer.FullName</a>
                                    <div class="small text-muted font-monospace">@customer.PhoneNumber</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted small text-truncate" style="max-width:220px" title="@customer.Address">@(string.IsNullOrWhiteSpace(customer.Address) ? "–" : customer.Address)</td>
                        <td class="text-end num">@customer.TotalPurchases</td>
                        <td class="text-end num fw-semibold">@customer.TotalRevenue.ToString("N2")</td>
                        @if (canFin) { <td class="text-end num @(customer.EstimatedProfit < 0 ? "text-danger" : "text-success")">@customer.EstimatedProfit.ToString("N2")</td> }
                        <td class="text-end num text-muted">@customer.TotalDiscounts.ToString("N2")</td>
                        <td class="text-end num @(customer.TotalRefunded > 0 ? "text-danger" : "text-muted")">@customer.TotalRefunded.ToString("N2")</td>
                        <td class="actions"><a asp-action="Details" asp-route-id="@customer.CustomerId" class="btn btn-ghost btn-sm">Open @Html.Icon("chevron-right")</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pager is not null) { <partial name="_Pager" model="pager" /> }
</div>

<div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="addCustomerTitle">Add customer</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Add" method="post" id="addCustomerForm">
                <div class="modal-body d-grid gap-3">
                    <div>
                        <label class="form-label" for="addFullName">Full name</label>
                        <input type="text" name="fullName" id="addFullName" class="form-control" required autocomplete="off" maxlength="150" />
                    </div>
                    <div>
                        <label class="form-label" for="addPhone">Phone number</label>
                        <input type="tel" name="phoneNumber" id="addPhone" class="form-control font-monospace" required autocomplete="off" placeholder="01700000000" maxlength="30" />
                        <div class="form-text">Used to find the customer at the till.</div>
                    </div>
                    <div>
                        <label class="form-label" for="addAddress">Address (optional)</label>
                        <input type="text" name="address" id="addAddress" class="form-control" autocomplete="off" placeholder="For example: Mirpur 10, Dhaka" maxlength="500" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel <kbd>Esc</kbd></button>
                    <button type="submit" class="btn btn-primary">Add customer <kbd>Enter</kbd></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('filterForm'), search = document.getElementById('searchInput'), timer;
            if (search.value) { var v = search.value; search.focus(); search.value = ''; search.value = v; }
            document.getElementById('sortOrder').addEventListener('change', function () { form.submit(); });
            search.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(function () { form.submit(); }, 600); });
            document.addEventListener('keydown', function (e) {
                if (document.querySelector('.modal.show')) return;
                if (e.key === 'Insert') { e.preventDefault(); document.getElementById('newCustomerBtn').click(); }
                if (e.key === 'F2') { e.preventDefault(); search.focus(); search.select(); }
            });
            document.getElementById('addCustomerModal').addEventListener('shown.bs.modal', function () { document.getElementById('addFullName').focus(); });
        })();
    </script>
}
