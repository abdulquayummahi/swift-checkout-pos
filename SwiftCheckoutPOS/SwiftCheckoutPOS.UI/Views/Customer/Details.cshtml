@model SwiftCheckoutPOS.BLL.DTOs.CustomerProfileDTO
@{
    ViewData["Title"] = Model.FullName;
    var canFin = (bool)ViewBag.CanViewFinancials;
    string StatusClass(string s) => s switch { "Refunded" or "Voided" => "is-bad", "PartiallyRefunded" or "Held" or "Resumed" => "is-warn", _ => "is-ok" };
    string StatusText(string s) => s == "PartiallyRefunded" ? "Part refunded" : s;
}
<div class="page-head">
    <div class="d-flex align-items-center gap-3">
        <span class="avatar" style="width:56px;height:56px;font-size:1.1rem" aria-hidden="true">@UiHelpers.Initials(Model.FullName)</span>
        <div>
            <a asp-action="Index" class="btn btn-ghost btn-sm ps-0" id="backBtn">@Html.Icon("chevron-left") Customers</a>
            <h1 class="page-title">@Model.FullName</h1>
            <p class="page-sub"><span class="font-monospace">@Model.PhoneNumber</span>@(string.IsNullOrWhiteSpace(Model.Address) ? "" : " · " + Model.Address)</p>
        </div>
    </div>
    <div class="page-actions">
        <button class="btn btn-quiet" data-bs-toggle="modal" data-bs-target="#editCustomerModal" id="editCustomerBtn">@Html.Icon("pencil") Edit details <kbd>F2</kbd></button>
    </div>
</div>

<div class="figures mb-4">
    <div class="figure"><div class="figure-label">Spent</div><div class="figure-value">@Html.Money(Model.TotalRevenue)</div><div class="figure-note">@Model.TotalPurchases purchases</div></div>
    @if (canFin) { <div class="figure is-good"><div class="figure-label">Profit from this customer</div><div class="figure-value">@Html.Money(Model.EstimatedProfit)</div></div> }
    <div class="figure"><div class="figure-label">Discounts received</div><div class="figure-value">@Html.Money(Model.TotalDiscounts)</div></div>
    <div class="figure"><div class="figure-label">Refunded</div><div class="figure-value @(Model.TotalRefunded > 0 ? "text-danger" : "")">@Html.Money(Model.TotalRefunded)</div></div>
    <div class="figure"><div class="figure-label">Items bought</div><div class="figure-value">@Model.TotalItemsSold</div></div>
</div>

<div class="card">
    <div class="panel-head"><h2>Purchase history</h2></div>
    @if (!Model.PurchaseHistory.Any())
    {
        <div class="empty">@Html.Icon("receipt")<div class="empty-title">No purchases yet</div><div class="small">Link this customer at the till to record their purchases.</div></div>
    }
    else
    {
        <div class="table-responsive" style="max-height:520px">
            <table class="table table-hover">
                <thead class="sticky-top"><tr><th>Receipt</th><th>Date</th><th>Paid by</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (var txn in Model.PurchaseHistory)
                    {
                        <tr>
                            <td class="font-monospace small">@txn.ReceiptNumber</td>
                            <td class="text-muted small text-nowrap">@txn.SaleDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@txn.PaymentMethod</td>
                            <td><span class="status @StatusClass(txn.OrderStatus)">@StatusText(txn.OrderStatus)</span></td>
                            <td class="text-end num fw-semibold">@txn.TotalAmount.ToString("N2")</td>
                            <td class="actions"><button class="btn btn-ghost btn-sm" data-bs-toggle="modal" data-bs-target="#modal-@txn.SaleId">Details</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="editCustomerModal" tabindex="-1" aria-labelledby="editTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title" id="editTitle">Edit customer</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <form asp-action="Edit" method="post" id="editCustomerForm">
                <input type="hidden" name="customerId" value="@Model.CustomerId" />
                <div class="modal-body d-grid gap-3">
                    <div><label class="form-label" for="editFullName">Full name</label><input type="text" name="fullName" id="editFullName" value="@Model.FullName" class="form-control" required autocomplete="off" maxlength="150" /></div>
                    <div><label class="form-label" for="editPhone">Phone number</label><input type="tel" name="phoneNumber" id="editPhone" value="@Model.PhoneNumber" class="form-control font-monospace" required autocomplete="off" maxlength="30" /></div>
                    <div><label class="form-label" for="editAddress">Address (optional)</label><input type="text" name="address" id="editAddress" value="@Model.Address" class="form-control" autocomplete="off" maxlength="500" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel <kbd>Esc</kbd></button><button type="submit" class="btn btn-primary">Save changes <kbd>Enter</kbd></button></div>
            </form>
        </div>
    </div>
</div>

@foreach (var txn in Model.PurchaseHistory)
{
    <div class="modal fade" id="modal-@txn.SaleId" tabindex="-1" aria-labelledby="t-@txn.SaleId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title font-monospace" id="t-@txn.SaleId">@txn.ReceiptNumber</h2>
                        <div class="small text-muted">@txn.SaleDate.ToString("dd MMM yyyy, HH:mm") · @txn.PaymentMethod · <span class="status @StatusClass(txn.OrderStatus)">@StatusText(txn.OrderStatus)</span></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <table class="table">
                        <thead><tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Line total</th></tr></thead>
                        <tbody>
                            @foreach (var item in txn.SaleItems)
                            {
                                <tr><td>@item.ProductName</td><td class="text-end num">@item.Quantity</td><td class="text-end num">@item.LineTotal.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer justify-content-between">
                    <div class="small text-muted">Discount @Html.Money(txn.DiscountAmount)@if (canFin) { <span> · Profit @Html.Money(txn.EstimatedProfit)</span> }</div>
                    <div class="num fs-4 fw-semibold">@Html.Money(txn.TotalAmount)</div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('keydown', function (e) {
            if (document.querySelector('.modal.show')) return;
            if (e.key === 'F2') { e.preventDefault(); document.getElementById('editCustomerBtn').click(); }
        });
        document.getElementById('editCustomerModal').addEventListener('shown.bs.modal', function () { var i = document.getElementById('editFullName'); i.focus(); i.select(); });
    </script>
}
