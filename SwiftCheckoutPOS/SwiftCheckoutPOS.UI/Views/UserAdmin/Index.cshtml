@model IEnumerable<SwiftCheckoutPOS.BLL.DTOs.UserListDTO>
@{
    ViewData["Title"] = "Staff accounts";
}
<div class="page-head">
    <div>
        <h1 class="page-title">Staff accounts</h1>
        <p class="page-sub">Everyone signs in with their own account, so sales, refunds and drawer openings show who did them.</p>
    </div>
    <div class="page-actions"><a asp-action="Create" class="btn btn-primary">@Html.Icon("user-plus") Add staff member</a></div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Name</th><th>Username</th><th>Role</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="avatar" aria-hidden="true">@UiHelpers.Initials(user.FullName)</span>
                                <a asp-action="Edit" asp-route-id="@user.UserId" class="fw-semibold text-body text-decoration-none">@user.FullName</a>
                            </div>
                        </td>
                        <td class="font-monospace text-muted">@user.Username</td>
                        <td><span class="badge @(user.Role == "Admin" ? "bg-primary" : user.Role == "Manager" ? "bg-warning" : "bg-secondary")">@user.Role</span></td>
                        <td><span class="status @(user.IsActive ? "is-ok" : "is-bad")">@(user.IsActive ? "Can sign in" : "Turned off")</span></td>
                        <td class="actions"><a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-ghost btn-sm">@Html.Icon("pencil") Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="help mt-3">Cashier: till, held orders, customers, own shift. Manager: also products, refunds, expenses and settings. Admin: everything, including staff, backups and all money figures.</p>
