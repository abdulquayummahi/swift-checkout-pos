<!-- Project: SwiftCheckoutPOS.UI -->
<!-- File: Views/UserAdmin/Index.cshtml -->
@model IEnumerable<SwiftCheckoutPOS.BLL.DTOs.UserListDTO>
@{
    ViewData["Title"] = "Personnel Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark m-0">Personnel Management</h2>
    <a asp-action="Create" class="btn btn-success fw-bold px-4 shadow-sm">+ Provision Employee</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fw-bold shadow-sm border-0 py-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold shadow-sm border-0 py-2">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="py-3 ps-4">System Username</th>
                    <th class="py-3">Employee Name</th>
                    <th class="py-3 text-center">Security Role</th>
                    <th class="py-3 text-center">Status</th>
                    <th class="py-3 text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white">
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="font-monospace fw-bold ps-4">@user.Username</td>
                        <td class="fw-bold text-dark">@user.FullName</td>
                        <td class="text-center">
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-dark">Administrator</span>
                            }
                            else
                            {

                                <span class="badge bg-primary">Cashier</span>
                            }
                        </td>
                        <td class="text-center fw-bold">
                            @if (user.IsActive)
                            {
                                <span class="text-success">Active</span>
                            }
                            else
                            {

                                <span class="text-danger">Deactivated</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary px-3 fw-bold">Modify</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>