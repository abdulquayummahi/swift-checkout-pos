@model SwiftCheckoutPOS.UI.Models.UserViewModel
@{
    ViewData["Title"] = "Add staff member";
    ViewData["Narrow"] = true;
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="btn btn-ghost btn-sm mb-2 ps-0">@Html.Icon("chevron-left") Staff accounts</a>
        <h1 class="page-title">Add staff member</h1>
    </div>
</div>
<form asp-action="Create" method="post" class="card">
    <input type="hidden" asp-for="IsActive" value="true" />
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
        <partial name="_UserFields" model="Model" />
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-quiet">Cancel</a>
        <button type="submit" class="btn btn-primary" data-busy="Saving…">@Html.Icon("check") Add staff member</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RevealPassword" />
}
