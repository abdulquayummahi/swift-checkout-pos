@model SwiftCheckoutPOS.UI.Models.UserViewModel
@{
    ViewData["Title"] = "Edit " + Model.FullName;
    ViewData["Narrow"] = true;
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="btn btn-ghost btn-sm mb-2 ps-0">@Html.Icon("chevron-left") Staff accounts</a>
        <h1 class="page-title">@Model.FullName</h1>
        <p class="page-sub"><span class="font-monospace">@Model.Username</span> · <span class="status @(Model.IsActive ? "is-ok" : "is-bad")">@(Model.IsActive ? "Can sign in" : "Turned off")</span></p>
    </div>
</div>
<form asp-action="Edit" method="post" class="card">
    <input type="hidden" asp-for="UserId" />
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
        <partial name="_UserFields" model="Model" />
        <div class="divider-dashed my-4"></div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch" id="activeSwitch" />
            <label class="form-check-label fw-semibold" for="activeSwitch">Can sign in</label>
        </div>
        <div class="form-text">Turning this off signs the person out at once. Their past sales keep their name.</div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-quiet">Cancel</a>
        <button type="submit" class="btn btn-primary" data-busy="Saving…">@Html.Icon("check") Save changes</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RevealPassword" />
}
