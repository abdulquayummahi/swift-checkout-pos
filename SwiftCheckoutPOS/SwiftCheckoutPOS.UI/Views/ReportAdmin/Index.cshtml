@model SwiftCheckoutPOS.BLL.DTOs.ReportDashboardDTO
@{
    ViewData["Title"] = "Reports";
    string StatusClass(string s) => s switch { "Refunded" or "Voided" => "is-bad", "Completed" => "is-ok", _ => "is-warn" };
}
<div class="page-head">
    <div>
        <h1 class="page-title">Sales report</h1>
        <p class="page-sub">@Model.AppliedStartDate.ToString("dd MMM yyyy") to @Model.AppliedEndDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Insights" asp-action="ExportSales" asp-route-startDate="@Model.AppliedStartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.AppliedEndDate.ToString("yyyy-MM-dd")" class="btn btn-quiet" title="Download these sales as a spreadsheet">@Html.Icon("download") Export (CSV)</a>
        <button class="btn btn-primary" id="btnPreviewZReport">@Html.Icon("printer") Z-report for these dates <kbd>F8</kbd></button>
    </div>
</div>

<form asp-action="Index" method="get" id="filterForm" class="d-flex gap-2 flex-wrap align-items-end mb-3">
    <div><label class="form-label" for="startDate">From</label><input type="date" name="startDate" id="startDate" value="@Model.AppliedStartDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div><label class="form-label" for="endDate">To</label><input type="date" name="endDate" id="endDate" value="@Model.AppliedEndDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="flex-grow-1" style="max-width:420px">
        <label class="form-label" for="searchInput">Find a receipt</label>
        <div class="input-group"><span class="input-group-text">@Html.Icon("search")</span><input type="search" name="searchQuery" id="searchInput" value="@ViewBag.SearchQuery" class="form-control font-monospace" placeholder="SCP-20261104-0001" autocomplete="off" /><span class="input-group-text"><kbd>F2</kbd></span></div>
    </div>
    <a href="@Url.Action("Index", "ReportAdmin")" class="btn btn-ghost">@Html.Icon("x") Reset</a>
</form>

<div class="figures mb-3">
    <div class="figure"><div class="figure-label">Revenue</div><div class="figure-value">@Html.Money(Model.GrossRevenue)</div></div>
    <div class="figure is-good"><div class="figure-label">Estimated profit</div><div class="figure-value">@Html.Money(Model.EstimatedProfit)</div></div>
    <div class="figure"><div class="figure-label">Discounts</div><div class="figure-value">@Html.Money(Model.TotalDiscounts)</div></div>
    <div class="figure"><div class="figure-label">VAT collected</div><div class="figure-value">@Html.Money(Model.TaxLiabilities)</div></div>
</div>
<div class="figures mb-4">
    <div class="figure"><div class="figure-label">Completed sales</div><div class="figure-value">@Model.CompletedOrders</div></div>
    <div class="figure"><div class="figure-label">Items sold</div><div class="figure-value">@Model.ItemsSold</div></div>
    <div class="figure @(Model.HeldTransactions > 0 ? "is-warn" : "")"><div class="figure-label">Held orders</div><div class="figure-value">@Model.HeldTransactions</div></div>
    <div class="figure @(Model.RefundedTransactions > 0 ? "is-bad" : "")"><div class="figure-label">Refunded sales</div><div class="figure-value">@Model.RefundedTransactions</div></div>
</div>

<div class="table-wrap">
    <div class="table-responsive" style="max-height:620px">
        <table class="table table-hover">
            <thead class="sticky-top"><tr><th>When</th><th>Receipt</th><th>Customer</th><th>Cashier</th><th class="text-end">Subtotal</th><th class="text-end">Discount</th><th class="text-end">Total</th><th class="text-end">Profit</th><th>Status</th></tr></thead>
            <tbody>
                @if (Model.Transactions == null || !Model.Transactions.Any())
                {
                    <tr><td colspan="9"><div class="empty">@Html.Icon("reports")<div class="empty-title">No sales in these dates</div><div class="small">Choose other dates above.</div></div></td></tr>
                }
                else
                {
                    foreach (var tx in Model.Transactions)
                    {
                        <tr>
                            <td class="text-muted small text-nowrap">@tx.SaleDate.ToString("dd MMM, HH:mm")</td>
                            <td class="font-monospace small">@(tx.OrderStatus is "Held" or "Resumed" ? "Held order" : tx.ReceiptNumber)</td>
                            <td>@(string.IsNullOrWhiteSpace(tx.CustomerName) ? "Walk-in" : tx.CustomerName)</td>
                            <td class="text-muted">@UiHelpers.Person(tx.CashierName)</td>
                            <td class="text-end num">@tx.SubTotal.ToString("N2")</td>
                            <td class="text-end num text-muted">@tx.DiscountAmount.ToString("N2")</td>
                            <td class="text-end num fw-semibold">@tx.TotalAmount.ToString("N2")</td>
                            <td class="text-end num text-success">@tx.EstimatedProfit.ToString("N2")</td>
                            <td><span class="status @StatusClass(tx.OrderStatus)">@(tx.OrderStatus == "PartiallyRefunded" ? "Part refunded" : tx.OrderStatus)</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="zReportPreviewModal" tabindex="-1" aria-labelledby="zTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:480px">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title" id="zTitle">Z-report</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body text-center"><pre id="previewContent" class="receipt-paper d-inline-block"></pre></div>
            <div class="modal-footer"><button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Close <kbd>Esc</kbd></button><button type="button" class="btn btn-primary" id="confirmPrintBtn">@Html.Icon("printer") Print <kbd>Enter</kbd></button></div>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('filterForm'), search = document.getElementById('searchInput');
            var startDate = document.getElementById('startDate'), endDate = document.getElementById('endDate');
            var modalEl = document.getElementById('zReportPreviewModal'), modal = new bootstrap.Modal(modalEl), timer;
            if (search.value) { var v = search.value; search.focus(); search.value = ''; search.value = v; }
            function q() { return 'startDate=' + encodeURIComponent(startDate.value) + '&endDate=' + encodeURIComponent(endDate.value); }
            function preview() {
                fetch('/ReportAdmin/GetZReportPreview?' + q(), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (d) { if (d.success) { document.getElementById('previewContent').textContent = d.preview; modal.show(); } else scposToast('error', d.message); })
                    .catch(function () { scposToast('error', 'The Z-report could not be prepared.'); });
            }
            function print() {
                var btn = document.getElementById('confirmPrintBtn'), token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                btn.disabled = true;
                fetch('/ReportAdmin/PrintZReport?' + q(), { method: 'POST', headers: { 'RequestVerificationToken': token } })
                    .then(function (r) { return r.json(); })
                    .then(function (d) { modal.hide(); scposToast(d.success ? 'success' : 'error', d.message); })
                    .catch(function () { modal.hide(); scposToast('error', 'The printer did not respond.'); })
                    .finally(function () { btn.disabled = false; });
            }
            document.getElementById('btnPreviewZReport').addEventListener('click', preview);
            document.getElementById('confirmPrintBtn').addEventListener('click', print);
            [startDate, endDate].forEach(function (el) { el.addEventListener('change', function () { if (startDate.value && endDate.value) form.submit(); }); });
            search.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(function () { form.submit(); }, 600); });
            document.addEventListener('keydown', function (e) {
                if (modalEl.classList.contains('show')) { if (e.key === 'Enter') { e.preventDefault(); print(); } return; }
                if (document.querySelector('.modal.show')) return;
                if (e.key === 'F2') { e.preventDefault(); search.focus(); search.select(); }
                if (e.key === 'F8') { e.preventDefault(); preview(); }
            });
        })();
    </script>
}
