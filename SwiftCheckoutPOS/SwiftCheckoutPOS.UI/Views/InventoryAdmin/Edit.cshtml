@model SwiftCheckoutPOS.UI.Models.EditProductViewModel
@{
    ViewData["Title"] = "Edit " + Model.ProductName;
    var units = new List<(string, string)> { ("pcs", "Pieces"), ("kg", "Kilograms"), ("ltr", "Litres"), ("box", "Box") };
    if (!string.IsNullOrWhiteSpace(Model.UnitOfMeasure) && units.All(u => u.Item1 != Model.UnitOfMeasure)) { units.Insert(0, (Model.UnitOfMeasure, Model.UnitOfMeasure)); }
    var image = string.IsNullOrWhiteSpace(Model.ExistingImagePath) ? "/img/product.svg" : Model.ExistingImagePath.Contains('/') ? Model.ExistingImagePath : "/images/products/" + Model.ExistingImagePath;
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="btn btn-ghost btn-sm mb-2 ps-0">@Html.Icon("chevron-left") Products and stock</a>
        <h1 class="page-title">@Model.ProductName</h1>
        <p class="page-sub"><span class="font-monospace">@Model.Barcode</span> · <span class="status @(Model.IsActive ? "is-ok" : "")">@(Model.IsActive ? "On sale" : "Hidden from the till")</span></p>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="productForm">
    <input type="hidden" asp-for="RowVersion" />
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="ExistingImagePath" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
    <div class="row g-3">
        <div class="col-xl-8 d-grid gap-3">
            <section class="card">
                <div class="panel-head"><h2>Basics</h2></div>
                <div class="panel-body row g-3">
                    <div class="col-md-6">
                        <label asp-for="Barcode" class="form-label">Barcode</label>
                        <input asp-for="Barcode" class="form-control font-monospace" autocomplete="off" />
                        <span asp-validation-for="Barcode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProductName" class="form-label">Name</label>
                        <input asp-for="ProductName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="ProductName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-baseline"><label asp-for="CategoryId" class="form-label">Category</label><button type="button" class="btn btn-link btn-sm p-0" data-quick-add="Category">@Html.Icon("plus") New category</button></div>
                        <select asp-for="CategoryId" asp-items="Model.AvailableCategories" class="form-select"><option value="">Choose a category</option></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-baseline"><label asp-for="VendorId" class="form-label">Supplier</label><button type="button" class="btn btn-link btn-sm p-0" data-quick-add="Vendor">@Html.Icon("plus") New supplier</button></div>
                        <select asp-for="VendorId" asp-items="Model.AvailableVendors" class="form-select"><option value="">Choose a supplier</option></select>
                        <span asp-validation-for="VendorId" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Notes (optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </section>
            <section class="card">
                <div class="panel-head"><h2>Price</h2></div>
                <div class="panel-body row g-3">
                    <div class="col-md-4">
                        <label asp-for="CostPrice" class="form-label">Cost per unit</label>
                        <div class="input-group"><span class="input-group-text">৳</span><input asp-for="CostPrice" class="form-control num" type="number" step="0.01" min="0" asp-format="{0:0.00}" placeholder="@(Model.CostPrice == null ? "Hidden. Leave empty to keep" : "")" /></div>
                        <span asp-validation-for="CostPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SellingPrice" class="form-label">Selling price</label>
                        <div class="input-group"><span class="input-group-text">৳</span><input asp-for="SellingPrice" class="form-control num" type="number" step="0.01" min="0" asp-format="{0:0.00}" /></div>
                        <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TaxRate" class="form-label">VAT included in the price</label>
                        <div class="input-group"><input asp-for="TaxRate" class="form-control num" type="number" step="0.01" min="0" asp-format="{0:0.00}" /><span class="input-group-text">%</span></div>
                        <span asp-validation-for="TaxRate" class="text-danger small"></span>
                    </div>
                    <div class="col-12 help">Price changes apply to new sales only; past receipts keep the price they were sold at.</div>
                </div>
            </section>
            <section class="card">
                <div class="panel-head"><h2>Stock</h2></div>
                <div class="panel-body row g-3">
                    <div class="col-md-4">
                        <label asp-for="StockQuantity" class="form-label">In stock now</label>
                        <input asp-for="StockQuantity" class="form-control num" type="number" readonly tabindex="-1" />
                        <div class="form-text">Change it with Restock or Correct a count.</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ReorderLevel" class="form-label">Warn when stock reaches</label>
                        <input asp-for="ReorderLevel" class="form-control num" type="number" min="0" />
                        <span asp-validation-for="ReorderLevel" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="UnitOfMeasure" class="form-label">Sold by</label>
                        <select asp-for="UnitOfMeasure" class="form-select">
                            @foreach (var (value, text) in units) { <option value="@value">@text (@value)</option> }
                        </select>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-xl-4">
            <section class="card" style="position:sticky;top:calc(var(--topbar-h) + 1rem)">
                <div class="panel-head"><h2>Picture and status</h2></div>
                <div class="panel-body">
                    <img id="imagePreview" src="@image" alt="" class="w-100 rounded-3 border mb-3" style="aspect-ratio:4/3;object-fit:cover" onerror="this.onerror=null;this.src='/img/product.svg';" />
                    <label asp-for="ImageFile" class="form-label">Replace the picture (optional)</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-preview="imagePreview" />
                    <div class="form-text mb-3">JPG, PNG or WebP, up to 2 MB. Leave empty to keep the current one.</div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch" />
                        <label class="form-check-label fw-semibold" for="activeSwitch">On sale at the till</label>
                    </div>
                    <div class="form-text">Turn off to hide it from the till. Its sales history stays.</div>
                </div>
                <div class="card-footer d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-quiet">Cancel</a>
                    <button type="submit" class="btn btn-primary" data-busy="Saving…">@Html.Icon("check") Save changes</button>
                </div>
            </section>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ProductFormScripts" />
}
