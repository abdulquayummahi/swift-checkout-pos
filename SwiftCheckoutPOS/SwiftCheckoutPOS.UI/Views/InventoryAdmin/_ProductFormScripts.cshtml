@* Shared by Add product and Edit product: picture preview and the "new category / supplier" dialog. *@
<div class="modal fade" id="quickAddModal" tabindex="-1" aria-labelledby="quickAddTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px">
        <div class="modal-content">
            <form id="quickAddForm">
                <div class="modal-header"><h2 class="modal-title" id="quickAddTitle">New category</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <label class="form-label" for="quickAddName">Name</label>
                    <input id="quickAddName" class="form-control" required maxlength="100" autocomplete="off" />
                    <div class="text-danger small mt-2" id="quickAddError" role="alert"></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Add</button></div>
            </form>
        </div>
    </div>
</div>
<script>
        (function () {
            document.querySelectorAll('input[type=file][data-preview]').forEach(function (input) {
                input.addEventListener('change', function () {
                    var f = input.files && input.files[0];
                    if (f) document.getElementById(input.dataset.preview).src = URL.createObjectURL(f);
                });
            });
            var modalEl = document.getElementById('quickAddModal'), type = 'Category';
            var modal = new bootstrap.Modal(modalEl);
            document.querySelectorAll('[data-quick-add]').forEach(function (b) {
                b.addEventListener('click', function () {
                    type = b.dataset.quickAdd;
                    document.getElementById('quickAddTitle').textContent = type === 'Category' ? 'New category' : 'New supplier';
                    document.getElementById('quickAddName').value = '';
                    document.getElementById('quickAddError').textContent = '';
                    modal.show();
                });
            });
            modalEl.addEventListener('shown.bs.modal', function () { document.getElementById('quickAddName').focus(); });
            document.getElementById('quickAddForm').addEventListener('submit', function (e) {
                e.preventDefault();
                var name = document.getElementById('quickAddName').value.trim();
                if (!name) return;
                var data = new FormData();
                data.append(type === 'Category' ? 'categoryName' : 'vendorName', name);
                var token = document.querySelector('#productForm input[name="__RequestVerificationToken"]');
                if (token) data.append('__RequestVerificationToken', token.value);
                fetch('/InventoryAdmin/QuickAdd' + type, { method: 'POST', body: data })
                    .then(function (r) { return r.json(); })
                    .then(function (result) {
                        if (!result.success) { document.getElementById('quickAddError').textContent = result.message || 'It could not be added.'; return; }
                        // Add the new choice and select it, without reloading the half-filled form.
                        var select = document.getElementById(type === 'Category' ? 'CategoryId' : 'VendorId');
                        if (result.id) { var o = new Option(name, result.id, true, true); select.add(o); modal.hide(); scposToast('success', (type === 'Category' ? 'Category' : 'Supplier') + ' "' + name + '" added.'); }
                        else { window.location.reload(); }
                    })
                    .catch(function () { document.getElementById('quickAddError').textContent = 'It could not be added. Try again.'; });
            });
        })();
    </script>
