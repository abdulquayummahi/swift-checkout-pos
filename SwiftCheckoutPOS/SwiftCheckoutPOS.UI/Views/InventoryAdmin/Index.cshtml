@model IEnumerable<SwiftCheckoutPOS.BLL.DTOs.ProductDTO>
@{
    ViewData["Title"] = "Products and stock";
    var canFin = (bool)ViewBag.CanViewFinancials;
    var sort = (string?)ViewBag.SortOrder;
    string ImageFor(string? path) => string.IsNullOrWhiteSpace(path) ? "/img/product.svg" : path.Contains('/') ? path : "/images/products/" + path;
    var pager = ViewBag.Page as SwiftCheckoutPOS.UI.Models.PageInfo;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Products and stock</h1>
        <p class="page-sub">@(pager?.TotalItems ?? Model.Count()) products. Restock deliveries, return goods to a supplier or correct a count.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-quiet" data-bs-toggle="modal" data-bs-target="#restockModal" id="btnRestock">@Html.Icon("package-plus") Restock <kbd>F3</kbd></button>
        <button class="btn btn-quiet" data-bs-toggle="modal" data-bs-target="#rtvModal" id="btnRtv">@Html.Icon("truck") Return to supplier <kbd>F4</kbd></button>
        <button class="btn btn-quiet" data-bs-toggle="modal" data-bs-target="#adjustModal" id="btnAdjust">@Html.Icon("list") Correct a count <kbd>F6</kbd></button>
        <a asp-controller="Export" asp-action="Products" class="btn btn-quiet" title="Download the product list as a spreadsheet">@Html.Icon("download") Export</a>
        <a asp-action="Create" class="btn btn-primary">@Html.Icon("plus") Add product</a>
    </div>
</div>

<form asp-action="Index" method="get" id="filterForm" class="d-flex gap-2 flex-wrap mb-3" role="search">
    <div class="input-group flex-grow-1" style="max-width:520px">
        <span class="input-group-text">@Html.Icon("search")</span>
        <input type="search" name="searchQuery" id="searchInput" value="@ViewBag.SearchQuery" class="form-control" placeholder="Search by name, barcode or category" autocomplete="off" aria-label="Search products" />
        <span class="input-group-text"><kbd>F2</kbd></span>
    </div>
    <select name="sortOrder" id="sortOrder" class="form-select" style="width:auto" aria-label="Sort">
        <option value="" selected="@(string.IsNullOrEmpty(sort))">Name A to Z</option>
        <option value="name_desc" selected="@(sort == "name_desc")">Name Z to A</option>
        <option value="stock_asc" selected="@(sort == "stock_asc")">Lowest stock first</option>
        <option value="stock_desc" selected="@(sort == "stock_desc")">Highest stock first</option>
        <option value="retail_desc" selected="@(sort == "retail_desc")">Highest price first</option>
        <option value="retail_asc" selected="@(sort == "retail_asc")">Lowest price first</option>
        @if (canFin)
        {
            <option value="margin_desc" selected="@(sort == "margin_desc")">Highest margin first</option>
            <option value="margin_asc" selected="@(sort == "margin_asc")">Lowest margin first</option>
            <option value="cost_desc" selected="@(sort == "cost_desc")">Highest cost first</option>
            <option value="cost_asc" selected="@(sort == "cost_asc")">Lowest cost first</option>
        }
        <option value="status_asc" selected="@(sort == "status_asc")">Active first</option>
        <option value="status_desc" selected="@(sort == "status_desc")">Inactive first</option>
    </select>
    @if (!string.IsNullOrEmpty((string?)ViewBag.SearchQuery) || !string.IsNullOrEmpty(sort))
    {
        <a href="@Url.Action("Index", "InventoryAdmin")" class="btn btn-ghost">@Html.Icon("x") Clear</a>
    }
</form>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    @if (canFin) { <th class="text-end">Cost</th> }
                    <th class="text-end">Price</th>
                    @if (canFin) { <th class="text-end">Margin</th> }
                    <th class="text-end">In stock</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8">
                        <div class="empty">@Html.Icon("products")<div class="empty-title">No products found</div>
                            <div class="small">@(string.IsNullOrEmpty((string?)ViewBag.SearchQuery) ? "Add your first product to start selling." : "Try a different search.")</div>
                        </div>
                    </td></tr>
                }
                @foreach (var product in Model)
                {
                    var low = product.StockQuantity <= product.ReorderLevel;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@ImageFor(product.ImagePath)" class="thumb" alt="" loading="lazy" onerror="this.onerror=null;this.src='/img/product.svg';" />
                                <div class="min-w-0">
                                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="fw-semibold text-body text-decoration-none">@product.ProductName</a>
                                    <div class="small text-muted font-monospace">@product.Barcode</div>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted">@product.CategoryName</td>
                        @if (canFin) { <td class="text-end num text-muted">@product.CostPrice.ToString("N2")</td> }
                        <td class="text-end num fw-semibold">@product.SellingPrice.ToString("N2")</td>
                        @if (canFin) { <td class="text-end num @(product.MarginPercentage >= 0 ? "text-success" : "text-danger")">@product.MarginPercentage.ToString("0.0")%</td> }
                        <td class="text-end">
                            <span class="num fw-semibold @(product.StockQuantity <= 0 ? "text-danger" : low ? "text-warning" : "")">@product.StockQuantity</span> <span class="small text-muted">@product.UnitOfMeasure</span>
                            @if (low) { <div class="small @(product.StockQuantity <= 0 ? "text-danger" : "text-warning")">@(product.StockQuantity <= 0 ? "Out of stock" : "Low, reorder at " + product.ReorderLevel)</div> }
                            @if (product.ReservedQuantity > 0) { <div class="small text-muted" title="Reserved by held orders">@product.ReservedQuantity held</div> }
                        </td>
                        <td><span class="status @(product.IsActive ? "is-ok" : "")">@(product.IsActive ? "On sale" : "Hidden")</span></td>
                        <td class="actions"><a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-ghost btn-sm">@Html.Icon("pencil") Edit</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pager is not null) { <partial name="_Pager" model="pager" /> }
</div>

<div class="modal fade" id="restockModal" tabindex="-1" aria-labelledby="restockTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="restockTitle">Restock a product</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ProcessRestock" method="post">
                <div class="modal-body d-grid gap-3">
                    <div>
                        <label class="form-label" for="restockBarcode">Barcode</label>
                        <input type="text" name="barcode" id="restockBarcode" class="form-control form-control-lg font-monospace" required autocomplete="off" placeholder="Scan or type" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="addedQty">Quantity received</label>
                            <input id="addedQty" type="number" name="addedQty" class="form-control num" required min="1" autocomplete="off" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="batchCost">Total cost of this delivery (৳)</label>
                            <input id="batchCost" type="number" name="totalBatchCost" step="0.01" class="form-control num text-end" required min="0" autocomplete="off" placeholder="0.00" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="newRetail">New selling price (৳, optional)</label>
                        <input id="newRetail" type="number" name="newRetailPrice" step="0.01" class="form-control num" autocomplete="off" placeholder="Leave empty to keep the current price" />
                        <div class="form-text">The average cost is updated automatically.</div>
                    </div>
                    <details>
                        <summary>Free or bonus stock (cost 0)</summary>
                        <input type="text" name="zeroCostReason" maxlength="150" class="form-control mt-2" autocomplete="off" placeholder="Reason, needed only when the cost is 0" aria-label="Reason for zero cost" />
                    </details>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel <kbd>Esc</kbd></button>
                    <button type="submit" class="btn btn-primary">Add to stock <kbd>Enter</kbd></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="adjustModal" tabindex="-1" aria-labelledby="adjustTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="adjustTitle">Correct a stock count</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AdjustStock" method="post">
                <div class="modal-body d-grid gap-3">
                    <p class="text-muted small mb-0">Use this after counting the shelf. The difference and the reason are recorded in the activity log.</p>
                    <div>
                        <label class="form-label" for="adjustBarcode">Barcode</label>
                        <input type="text" name="barcode" id="adjustBarcode" class="form-control form-control-lg font-monospace" required autocomplete="off" placeholder="Scan or type" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="countedQty">Counted quantity</label>
                            <input id="countedQty" type="number" name="countedQuantity" class="form-control num" required min="0" autocomplete="off" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="adjustReason">Reason</label>
                            <select id="adjustReason" name="reason" class="form-select" required>
                                <option value="">Choose…</option>
                                @foreach (var r in SwiftCheckoutPOS.BLL.Services.InventoryService.StockAdjustmentReasons)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="adjustNote">Note (needed for Other)</label>
                        <input id="adjustNote" type="text" name="note" maxlength="150" class="form-control" autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel <kbd>Esc</kbd></button>
                    <button type="submit" class="btn btn-primary">Save count <kbd>Enter</kbd></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rtvModal" tabindex="-1" aria-labelledby="rtvTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="rtvTitle">Return goods to the supplier</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ProcessReturnToVendor" method="post">
                <div class="modal-body d-grid gap-3">
                    <div>
                        <label class="form-label" for="rtvBarcode">Barcode</label>
                        <input type="text" name="barcode" id="rtvBarcode" class="form-control form-control-lg font-monospace" required autocomplete="off" placeholder="Scan or type" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="returnQty">Quantity returned</label>
                            <input id="returnQty" type="number" name="returnQty" class="form-control num" required min="1" autocomplete="off" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="refundAmount">Money back from supplier (৳)</label>
                            <input id="refundAmount" type="number" name="refundAmount" step="0.01" class="form-control num text-end" required min="0" autocomplete="off" placeholder="0.00" />
                            <div class="form-text">Enter 0 if the supplier gives credit instead.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel <kbd>Esc</kbd></button>
                    <button type="submit" class="btn btn-danger">Remove from stock <kbd>Enter</kbd></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('filterForm');
            var search = document.getElementById('searchInput');
            var timer;
            if (search.value) { var v = search.value; search.focus(); search.value = ''; search.value = v; }
            document.getElementById('sortOrder').addEventListener('change', function () { form.submit(); });
            search.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(function () { form.submit(); }, 600); });
            document.addEventListener('keydown', function (e) {
                if (document.querySelector('.modal.show')) return;
                var map = { F3: 'btnRestock', F4: 'btnRtv', F6: 'btnAdjust' };
                if (e.key === 'F2') { e.preventDefault(); search.focus(); search.select(); }
                else if (map[e.key]) { e.preventDefault(); document.getElementById(map[e.key]).click(); }
            });
            [['restockModal', 'restockBarcode'], ['adjustModal', 'adjustBarcode'], ['rtvModal', 'rtvBarcode']].forEach(function (p) {
                document.getElementById(p[0]).addEventListener('shown.bs.modal', function () { document.getElementById(p[1]).focus(); });
            });
        })();
    </script>
}
