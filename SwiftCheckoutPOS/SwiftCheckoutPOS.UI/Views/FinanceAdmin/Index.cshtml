@model SwiftCheckoutPOS.BLL.DTOs.FinanceDashboardDTO
@{
    ViewData["Title"] = "Finance";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var payback = Math.Clamp(Model.PaybackPercentage, 0, 100);
}
<div class="page-head">
    <div>
        <h1 class="page-title">Finance</h1>
        <p class="page-sub">@Model.PeriodFrom.ToString("dd MMM yyyy") to @Model.PeriodTo.ToString("dd MMM yyyy"). Sales, stock and refunds are recorded automatically; add rent, bills, salaries and capital here.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEntryModal" id="newEntryBtn">@Html.Icon("plus") Record money in or out <kbd>Ins</kbd></button>
    </div>
</div>

<form asp-action="Index" method="get" id="filterForm" class="d-flex gap-2 flex-wrap align-items-end mb-3">
    <div><label class="form-label" for="startDate">From</label><input type="date" name="startDate" id="startDate" value="@ViewBag.StartDate" class="form-control" /></div>
    <div><label class="form-label" for="endDate">To</label><input type="date" name="endDate" id="endDate" value="@ViewBag.EndDate" class="form-control" /></div>
    <div class="flex-grow-1" style="max-width:420px">
        <label class="form-label" for="searchInput">Search category or note</label>
        <div class="input-group"><span class="input-group-text">@Html.Icon("search")</span><input type="search" name="searchQuery" id="searchInput" value="@ViewBag.SearchQuery" class="form-control" placeholder="For example: Utilities" autocomplete="off" /><span class="input-group-text"><kbd>F2</kbd></span></div>
    </div>
    <a href="@Url.Action("Index", "FinanceAdmin")" class="btn btn-ghost">@Html.Icon("x") Reset</a>
</form>

<div class="figures mb-2">
    <div class="figure"><div class="figure-label">Net sales</div><div class="figure-value">@Html.Money(Model.Period.NetSales)</div><div class="figure-note">Without VAT, after refunds</div></div>
    <div class="figure"><div class="figure-label">Gross profit</div><div class="figure-value">@Html.Money(Model.Period.GrossProfit)</div><div class="figure-note">Using cost at the time of sale</div></div>
    <div class="figure"><div class="figure-label">Operating expenses</div><div class="figure-value">@Html.Money(Model.OperatingExpenses)</div></div>
    <div class="figure @(Model.Period.NetProfit < 0 ? "is-bad" : "is-good")"><div class="figure-label">Net profit</div><div class="figure-value">@Html.Money(Model.Period.NetProfit)</div></div>
</div>
<p class="help mb-4">
    In this period: capital in @Html.Money(Model.TotalCapitalInflow) · stock bought @Html.Money(Model.InventoryCosts) · stock losses @Html.Money(Model.Period.StockLosses) · cash rounding @Html.Money(Model.Period.CashRounding) · refunds @Html.Money(Model.Period.RefundsExVat)
    @if (Model.Period.UnknownCostSales > 0) { <span class="text-danger fw-semibold"> · @Model.Period.UnknownCostSales sale(s) with unknown cost are left out of profit</span> }
</p>

<div class="row g-3 mb-4">
    <div class="col-xl-8">
        <div class="table-wrap h-100">
            <div class="panel-head"><h2>Ledger</h2><span class="small text-muted">@Model.Entries.Count() entries</span></div>
            <div class="table-responsive" style="max-height:560px">
                <table class="table table-hover">
                    <thead class="sticky-top"><tr><th>When</th><th>Category</th><th>Note</th><th class="text-end">Amount</th><th>By</th></tr></thead>
                    <tbody>
                        @if (!Model.Entries.Any())
                        {
                            <tr><td colspan="5"><div class="empty">@Html.Icon("finance")<div class="empty-title">Nothing recorded in this period</div><div class="small">Change the dates, or record a payment.</div></div></td></tr>
                        }
                        @foreach (var entry in Model.Entries)
                        {
                            var inflow = entry.TransactionType == "Inflow";
                            <tr>
                                <td class="text-muted small text-nowrap">@entry.TransactionDate.ToString("dd MMM, HH:mm")</td>
                                <td class="fw-semibold"><span class="d-inline-flex align-items-center gap-1 @(inflow ? "text-success" : "text-danger")">@Html.Icon(inflow ? "arrow-down" : "arrow-up")</span> @entry.Category</td>
                                <td class="text-muted small text-truncate" style="max-width:280px" title="@entry.Description">@(string.IsNullOrWhiteSpace(entry.Description) ? "–" : entry.Description)</td>
                                <td class="text-end num fw-semibold @(inflow ? "text-success" : "")">@(inflow ? "+" : "−")@entry.Amount.ToString("N2")</td>
                                <td class="small text-muted text-nowrap">@UiHelpers.Person(entry.RecordedBy)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="panel-head"><h2>Capital payback</h2><span class="small text-muted">All time</span></div>
            <div class="panel-body">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <span class="num" style="font-size:2.2rem;font-weight:600">@Model.PaybackPercentage.ToString("0.0")%</span>
                    <span class="small text-muted">of capital earned back</span>
                </div>
                <div class="bar mb-3" style="height:10px"><span style="width:@payback.ToString("0.0", inv)%"></span></div>
                <dl class="row small mb-0 gy-2">
                    <dt class="col-7 fw-normal text-muted">Capital invested</dt><dd class="col-5 text-end num mb-0">@Model.LifetimeCapital.ToString("N2")</dd>
                    <dt class="col-7 fw-normal text-muted">Net profit, all time</dt><dd class="col-5 text-end num mb-0 @(Model.LifetimeNetProfit < 0 ? "text-danger" : "text-success")">@Model.LifetimeNetProfit.ToString("N2")</dd>
                    <dt class="col-7 fw-normal text-muted">Average profit per month</dt><dd class="col-5 text-end num mb-0">@Model.AverageMonthlyProfit.ToString("N2")</dd>
                    <dt class="col-7 fw-normal text-muted">Net cash position</dt><dd class="col-5 text-end num mb-0 @(Model.Lifetime.NetCashPosition < 0 ? "text-danger" : "")">@Model.Lifetime.NetCashPosition.ToString("N2")</dd>
                    <dt class="col-7 fw-normal text-muted">Customers owe (Due)</dt><dd class="col-5 text-end num mb-0">@Model.Lifetime.DueOutstanding.ToString("N2")</dd>
                </dl>
                <div class="divider-dashed my-3"></div>
                <div class="fw-semibold">@Model.PaybackEstimate</div>
                <div class="help">@if (Model.Lifetime.BusinessStart is { } started) { var months = Model.Lifetime.MonthsActive; <text>Business started @started.ToString("dd MMM yyyy"), @(months < 1 ? "less than a month ago" : months == 1 ? "1 month ago" : $"{months:0.#} months ago").</text> } else { <text>No capital or sales recorded yet.</text> }</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addEntryModal" tabindex="-1" aria-labelledby="entryTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title" id="entryTitle">Record money in or out</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <form asp-action="AddEntry" method="post" id="addEntryForm">
                <div class="modal-body d-grid gap-3">
                    <div>
                        <label class="form-label" for="categorySelect">What is it?</label>
                        <select name="category" id="categorySelect" class="form-select" required>
                            <optgroup label="Money out">
                                @foreach (var c in SwiftCheckoutPOS.BLL.Services.MetricsService.ManualOutflow) { <option>@c</option> }
                            </optgroup>
                            <optgroup label="Money in">
                                @foreach (var c in SwiftCheckoutPOS.BLL.Services.MetricsService.ManualInflow) { <option>@c</option> }
                            </optgroup>
                        </select>
                        <div class="form-text">Stock purchases, cost of sales, stock corrections and refunds are recorded automatically.</div>
                    </div>
                    <div>
                        <label class="form-label" for="amountInput">Amount (৳)</label>
                        <input type="number" name="amount" id="amountInput" step="0.01" min="0.01" class="form-control form-control-lg num text-end" required autocomplete="off" placeholder="0.00" inputmode="decimal" />
                    </div>
                    <div>
                        <label class="form-label" for="descInput">Note</label>
                        <input type="text" name="description" id="descInput" class="form-control" autocomplete="off" placeholder="For example: October electricity bill" maxlength="500" />
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel <kbd>Esc</kbd></button><button type="submit" class="btn btn-primary">Save <kbd>Enter</kbd></button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('filterForm'), search = document.getElementById('searchInput'), timer;
            if (search.value) { var v = search.value; search.focus(); search.value = ''; search.value = v; }
            ['startDate', 'endDate'].forEach(function (id) { document.getElementById(id).addEventListener('change', function () { form.submit(); }); });
            search.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(function () { form.submit(); }, 600); });
            document.addEventListener('keydown', function (e) {
                if (document.querySelector('.modal.show')) return;
                if (e.key === 'Insert') { e.preventDefault(); document.getElementById('newEntryBtn').click(); }
                if (e.key === 'F2') { e.preventDefault(); search.focus(); search.select(); }
            });
            document.getElementById('addEntryModal').addEventListener('shown.bs.modal', function () { document.getElementById('amountInput').focus(); });
        })();
    </script>
}
