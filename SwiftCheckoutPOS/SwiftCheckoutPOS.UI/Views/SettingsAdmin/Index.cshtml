@{
    ViewData["Title"] = "Settings";
    ViewData["Narrow"] = true;
    var isAdmin = (bool)ViewBag.IsAdmin;
    var managerView = (bool)ViewBag.ManagerFinancialView;
}
<div class="page-head">
    <div>
        <h1 class="page-title">Settings</h1>
        <p class="page-sub">Shop-wide choices. Receipt and privacy settings can be changed by the Admin only; every change is written to the activity log.</p>
    </div>
</div>

<div class="d-grid gap-3">
    <section class="card">
        <div class="panel-head"><h2>Held orders</h2></div>
        <form asp-action="UpdateRetention" method="post" class="panel-body d-flex gap-4 flex-wrap align-items-end">
            <div class="flex-grow-1" style="min-width:260px;max-width:52ch">
                <label class="form-label" for="retentionInput">Cancel a held order automatically after</label>
                <p class="help mb-0">The reserved stock goes back on sale when a held order is cancelled. Enter 0 to never cancel automatically.</p>
            </div>
            <div class="input-group" style="width:200px">
                <input type="number" name="retentionHours" id="retentionInput" class="form-control num text-end" value="@ViewBag.RetentionHours" required min="0" max="87600" autocomplete="off" />
                <span class="input-group-text">hours</span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </section>

    @if (isAdmin)
    {
        var h = (SwiftCheckoutPOS.BLL.Hardware.ReceiptHeaderDTO)ViewBag.Header;
        <section class="card">
            <div class="panel-head"><h2>Receipt header</h2><span class="small text-muted">Printed at the top of every receipt</span></div>
            <form asp-action="SetReceiptHeader" method="post" class="panel-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" for="shopName">Shop name</label><input id="shopName" name="shopName" value="@h.ShopName" maxlength="48" class="form-control" required /></div>
                    <div class="col-md-6"><label class="form-label" for="shopPhone">Phone</label><input id="shopPhone" name="phone" value="@h.Phone" maxlength="48" class="form-control" /></div>
                    <div class="col-12"><label class="form-label" for="shopAddress">Address</label><input id="shopAddress" name="address" value="@h.Address" maxlength="48" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" for="shopBin">BIN</label><input id="shopBin" name="bin" value="@h.Bin" maxlength="48" class="form-control" /><div class="form-text">Only when the shop is VAT-registered.</div></div>
                    <div class="col-md-6"><label class="form-label" for="shopFooter">Message at the bottom</label><input id="shopFooter" name="footer" value="@h.Footer" maxlength="48" class="form-control" placeholder="For example: Thank you, come again" /></div>
                </div>
                <div class="d-flex justify-content-end mt-3"><button class="btn btn-primary">Save receipt header</button></div>
            </form>
        </section>
        <section class="card">
            <div class="panel-head"><h2>Money figures for Managers</h2><span class="status @(managerView ? "is-warn" : "is-ok")">@(managerView ? "Managers can see them" : "Admin only")</span></div>
            <form asp-action="SetManagerFinancialView" method="post" class="panel-body d-flex gap-4 flex-wrap align-items-center justify-content-between"
                  data-confirm="@(managerView ? "Hide money figures from Managers?" : "Show money figures to Managers?")" data-confirm-text="This covers profit, cost, margins, sales totals, the ledger and capital." data-confirm-ok="@(managerView ? "Hide" : "Show")">
                <input type="hidden" name="allow" value="@(managerView ? "false" : "true")" />
                <p class="mb-0 text-muted" style="max-width:56ch">When hidden, Managers still sell, restock and record expenses, but never see profit, cost, margins, sales totals, the ledger or capital. Backups stay Admin-only either way.</p>
                <button class="btn @(managerView ? "btn-outline-danger" : "btn-quiet")">@(managerView ? "Hide from Managers" : "Show to Managers")</button>
            </form>
        </section>
    }

    <section class="card">
        <div class="panel-head"><h2>Screen</h2><span class="small text-muted">This PC only</span></div>
        <div class="panel-body d-flex gap-3 flex-wrap align-items-center justify-content-between">
            <p class="mb-0 text-muted">Light, dark, or follow the Windows setting.</p>
            <div class="segmented" role="radiogroup" aria-label="Screen colours" id="themeChoice">
                <button type="button" data-theme="light">@Html.Icon("sun") Light</button>
                <button type="button" data-theme="dark">@Html.Icon("moon") Dark</button>
                <button type="button" data-theme="">Follow Windows</button>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById('themeChoice');
            function current() { try { return localStorage.getItem('scpos-theme') || ''; } catch (e) { return ''; } }
            function mark() { box.querySelectorAll('button').forEach(function (b) { var on = b.dataset.theme === current(); b.classList.toggle('is-active', on); b.setAttribute('aria-checked', on); b.setAttribute('role', 'radio'); }); }
            box.addEventListener('click', function (e) {
                var b = e.target.closest('button'); if (!b) return;
                try { if (b.dataset.theme) localStorage.setItem('scpos-theme', b.dataset.theme); else localStorage.removeItem('scpos-theme'); } catch (err) { }
                var dark = b.dataset.theme === 'dark' || (!b.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
                mark();
            });
            mark();
        })();
    </script>
}
