@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var notFound = Model.StatusCode == 404;
    var denied = Model.StatusCode is 401 or 403;
}

<div class="container py-5" style="max-width: 640px;">
    <h1 class="h3 fw-bold text-danger">@(notFound ? "Page not found" : denied ? "Not allowed" : "Something went wrong")</h1>
    <p class="mt-3">
        @if (notFound) { <text>This page does not exist.</text> }
        else if (denied) { <text>Your account cannot open this page.</text> }
        else { <text>The request could not be completed. If you were finishing a sale, check the last receipt (Reprint) before charging again.</text> }
    </p>
    @if (Model.ShowRequestId && !notFound)
    {
        <p class="text-muted small">Reference for the Admin: <code>@Model.RequestId</code> (details are in the log on this PC).</p>
    }
    <a class="btn btn-primary fw-bold" href="/Checkout/Index">Back to the till</a>
</div>
