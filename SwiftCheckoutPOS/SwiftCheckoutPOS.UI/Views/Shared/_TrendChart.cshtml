@model SwiftCheckoutPOS.BLL.DTOs.SalesTrendDTO
@* Bar chart of bill totals: one series, zero baseline, a round top value, two gridlines, an amount on hover or focus, and a table. *@
@{
    var trend = Model;
    var peak = trend.Points.Count == 0 ? 0m : trend.Points.Max(p => p.Total);
    decimal Nice(decimal max)
    {
        if (max <= 0) return 1000m;
        var step = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)max)));
        foreach (var m in new[] { 1m, 2m, 2.5m, 5m, 10m }) if (max <= m * step) return m * step;
        return 10m * step;
    }
    var top = Nice(peak);
    string Compact(decimal v) => v >= 1_000_000m ? (v / 1_000_000m).ToString("0.#") + "M" : v >= 1000m ? (v / 1000m).ToString("0.#") + "k" : v.ToString("0");
    string Label(SwiftCheckoutPOS.BLL.DTOs.SalesTrendPointDTO p) => trend.Unit switch
    {
        "hour" => p.Start.ToString("HH:mm"), "day" => trend.Points.Count > 10 ? p.Start.ToString("dd MMM") : p.Start.ToString("ddd dd"),
        "week" => p.Start.ToString("dd MMM"), _ => trend.Points.Select(x => x.Start.Year).Distinct().Count() > 1 ? p.Start.ToString("MMM yy") : p.Start.ToString("MMM")
    };
    string LongLabel(SwiftCheckoutPOS.BLL.DTOs.SalesTrendPointDTO p) => trend.Unit switch
    {
        "hour" => $"{p.Start:HH:mm}–{p.End:HH:mm}", "day" => p.Start.ToString("dddd dd MMM"),
        "week" => $"{p.Start:dd MMM} – {p.End.AddDays(-1):dd MMM}", _ => p.Start.ToString("MMMM yyyy")
    };
    var every = Math.Max(1, (int)Math.Ceiling(trend.Points.Count / 8.0));
    var name = trend.Unit switch { "hour" => "Sales by hour", "day" => "Sales by day", "week" => "Sales by week", _ => "Sales by month" };
}
@if (trend.Sales == 0)
{
    <div class="empty py-4">@Html.Icon("reports")<div class="empty-title">No sales in this period yet</div><div class="small">The chart fills in as sales are saved at the till.</div></div>
}
else
{
    <div class="trend-chart">
        <div class="trend-y" aria-hidden="true">
            <span style="top:0">@Compact(top)</span><span style="top:50%">@Compact(top / 2)</span><span style="top:100%">0</span>
        </div>
        <div class="trend-plot" role="group" aria-label="@name. Each bar shows its amount when selected; the table below lists them.">
            <div class="trend-grid" style="top:0"></div><div class="trend-grid" style="top:50%"></div>
            @foreach (var p in trend.Points)
            {
                var h = top == 0 ? 0 : Math.Round(p.Total / top * 100m, 1);
                <button type="button" class="trend-col" style="--h:@h.ToString(System.Globalization.CultureInfo.InvariantCulture)%"
                        aria-label="@LongLabel(p): @("৳" + p.Total.ToString("N2")), @p.Sales @(p.Sales == 1 ? "sale" : "sales")">
                    <span class="trend-bar"></span>
                    <span class="trend-tip">@LongLabel(p)<br /><strong>@("৳" + p.Total.ToString("N2"))</strong> · @p.Sales @(p.Sales == 1 ? "sale" : "sales")</span>
                </button>
            }
        </div>
        <div class="trend-x" aria-hidden="true">
            @for (var i = 0; i < trend.Points.Count; i++)
            {
                <span>@((i % every == 0 || i == trend.Points.Count - 1) && (i == trend.Points.Count - 1 || trend.Points.Count - 1 - i >= every) ? Label(trend.Points[i]) : "")</span>
            }
        </div>
    </div>
    <details class="trend-table">
        <summary>Show as a table</summary>
        <div class="table-responsive mt-2" style="max-height:280px">
            <table class="table table-sm mb-0">
                <thead class="sticky-top"><tr><th>@(trend.Unit switch { "hour" => "Hour", "day" => "Day", "week" => "Week", _ => "Month" })</th><th class="text-end">Sales</th><th class="text-end">Bill total</th></tr></thead>
                <tbody>
                    @foreach (var p in trend.Points.Where(x => x.Sales > 0))
                    {
                        <tr><td>@LongLabel(p)</td><td class="text-end num">@p.Sales</td><td class="text-end num">@p.Total.ToString("N2")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}
