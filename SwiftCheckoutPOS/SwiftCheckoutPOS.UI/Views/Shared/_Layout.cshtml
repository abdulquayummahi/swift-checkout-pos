@inject SwiftCheckoutPOS.BLL.Services.SettingsService Settings
@inject SwiftCheckoutPOS.BLL.Services.ShiftService Shifts
@inject SwiftCheckoutPOS.BLL.Services.InsightsService Insights
@inject SwiftCheckoutPOS.BLL.Services.BackupService Backups
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache Cache
@using Microsoft.Extensions.Caching.Memory
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["Controller"]?.ToString();
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Cashier";
    var isAdmin = role == "Admin";
    var isManager = isAdmin || role == "Manager";
    var canFin = signedIn && Settings.CanViewFinancials(role);
    var shift = signedIn ? Shifts.OpenShiftHeader() : null;
    var dashboard = isAdmin ? "AdminDashboard" : "ManagerDashboard";
    var action = ViewContext.RouteData.Values["Action"]?.ToString();
    var groups = new List<(string Title, List<(string Controller, string Action, string Text, string Icon, bool Show)> Links)>
    {
        ("Selling", new()
        {
            ("Shift", "Index", "Till shift", "shift", true),
            ("Refund", "Index", "Refunds and voids", "refund", isManager),
        }),
        ("Shop", new()
        {
            (dashboard, "Index", "Overview", "dashboard", isManager),
            ("Insights", "Index", "Insights", "insights", isManager && canFin),
            ("InventoryAdmin", "Index", "Products and stock", "products", isManager),
            ("Insights", "Stock", "Stock health", "boxes", isManager && canFin),
            ("Customer", "Index", "Customers", "customers", isManager),
        }),
        ("Money", new()
        {
            ("FinanceAdmin", "Index", canFin ? "Finance" : "Expenses", "finance", isManager),
            ("ReportAdmin", "Index", "Reports", "reports", isManager && canFin),
        }),
        ("Admin", new()
        {
            ("UserAdmin", "Index", "Staff accounts", "users", isAdmin),
            ("SettingsAdmin", "Index", "Settings", "settings", isManager),
            ("BackupAdmin", "Index", "Backup", "backup", isAdmin),
            ("AuditLog", "Index", "Activity log", "audit", isAdmin),
        }),
    };
    var active = controller is "ManagerDashboard" or "AdminDashboard" ? dashboard : controller;
    bool IsActive(string c, string a) => active == c && (c != "Insights" || (a == "Stock") == (action == "Stock"));

    // Alerts bell: things that need attention now. Backup warnings read the backup folder, so they are kept for a minute.
    var alerts = new List<SwiftCheckoutPOS.BLL.Services.AlertDTO>();
    if (signedIn)
    {
        var backupWarnings = !isAdmin ? null : Cache.GetOrCreate("layout-backup-warnings", e =>
        {
            e.AbsoluteExpirationRelativeToNow = TimeSpan.FromSeconds(60);
            try { return Backups.GetPage().Warnings.ToList(); } catch (Exception) { return new List<string>(); }
        });
        // A page must still open if the alerts cannot be read (for example on the error page while the database is busy).
        try { alerts = Insights.Alerts(isManager, isAdmin, canFin, shift is not null, Settings.GetHeldOrderRetentionHours(), backupWarnings); }
        catch (Exception) { alerts = new(); }
    }
    var urgent = alerts.Count(a => a.Level != "info");
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] – SwiftCheckout</title>
    <script>
        (function () { var t = null; try { t = localStorage.getItem('scpos-theme'); } catch (e) { }
            var d = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-bs-theme', d ? 'dark' : 'light'); })();
    </script>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" style="z-index:2000" href="#main">Skip to content</a>
    @if (signedIn)
    {
        <div class="app">
            <aside class="sidebar" aria-label="Main menu">
                <a class="brand" asp-controller="Checkout" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">৳</span>
                    <span><span class="brand-name d-block">SwiftCheckout</span><span class="brand-sub">Shop till</span></span>
                </a>
                <a class="side-link is-primary" asp-controller="Checkout" asp-action="Index">@Html.Icon("till") Open the till</a>
                @foreach (var group in groups)
                {
                    var shown = group.Links.Where(l => l.Show).ToList();
                    if (shown.Count == 0) { continue; }
                    <nav class="nav-group" aria-label="@group.Title">
                        <div class="nav-group-title">@group.Title</div>
                        @foreach (var l in shown)
                        {
                            <a class="side-link @(IsActive(l.Controller, l.Action) ? "is-active" : "")" asp-controller="@l.Controller" asp-action="@l.Action" aria-current="@(IsActive(l.Controller, l.Action) ? "page" : null)" data-nav="@l.Text">@Html.Icon(l.Icon) @l.Text</a>
                        }
                    </nav>
                }
                <div class="sidebar-foot">
                    <div class="whoami">
                        <span class="avatar" aria-hidden="true">@UiHelpers.Initials(User.Identity?.Name)</span>
                        <span class="min-w-0"><span class="whoami-name d-block text-truncate">@User.Identity?.Name</span><span class="whoami-role">@role</span></span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-1" data-confirm="Sign out?" data-confirm-text="The order on the till is cleared. Hold it first if you want to keep it." data-confirm-ok="Sign out">
                        <button type="submit" class="side-link w-100 border-0 bg-transparent">@Html.Icon("logout") Sign out</button>
                    </form>
                </div>
            </aside>
            <div class="sidebar-scrim" aria-hidden="true"></div>
            <div class="main">
                <header class="topbar">
                    <button type="button" class="btn btn-ghost btn-icon mobile-only" data-sidebar-open aria-label="Open menu">@Html.Icon("menu")</button>
                    <a class="shift-pill @(shift is null ? "is-closed" : "is-open")" asp-controller="Shift" asp-action="Index">
                        @(shift is null ? "No shift open" : $"Shift open since {shift.Value.OpenedAt:HH:mm}")
                    </a>
                    <button type="button" class="search-trigger" data-palette-open aria-label="Search products, customers, receipts and pages">
                        @Html.Icon("search") <span class="search-trigger-text">Search or jump to…</span> <kbd>Ctrl</kbd><kbd>K</kbd>
                    </button>
                    <div class="topbar-actions">
                        <div class="dropdown">
                            <button type="button" class="btn btn-ghost btn-icon bell" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                    aria-label="@(alerts.Count == 0 ? "Alerts: nothing needs attention" : $"Alerts: {alerts.Count} to look at")">
                                @Html.Icon("bell")
                                @if (alerts.Count > 0) { <span class="bell-count @(urgent > 0 ? "" : "is-info")">@alerts.Count</span> }
                            </button>
                            <div class="dropdown-menu dropdown-menu-end alerts-menu">
                                <div class="alerts-title">Needs attention</div>
                                @if (alerts.Count == 0)
                                {
                                    <div class="alerts-empty">@Html.Icon("check-circle") Nothing needs attention right now.</div>
                                }
                                @foreach (var a in alerts)
                                {
                                    <a class="alert-row is-@a.Level" asp-controller="@a.Controller" asp-action="@a.Action">
                                        @Html.Icon(a.Icon) <span>@a.Text</span> @Html.Icon("chevron-right", "alert-go")
                                    </a>
                                }
                            </div>
                        </div>
                        <button type="button" class="btn btn-ghost btn-icon" data-theme-toggle aria-pressed="false" title="Switch to dark mode">@Html.Icon("moon")</button>
                        <form asp-controller="Account" asp-action="LockNow" method="post" class="m-0">
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button type="submit" class="btn btn-quiet btn-sm" title="Lock screen">@Html.Icon("lock") <span class="hide-xs">Lock screen</span></button>
                        </form>
                    </div>
                </header>
                <main id="main" class="content @(ViewData["Narrow"] is true ? "is-narrow" : "")">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main id="main">@RenderBody()</main>
    }

    @if (signedIn)
    {
        <div class="modal fade palette" id="palette" tabindex="-1" aria-label="Search" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="palette-input">
                        @Html.Icon("search")
                        <input type="search" id="paletteInput" autocomplete="off" spellcheck="false" placeholder="Search products, customers, receipts or pages"
                               role="combobox" aria-expanded="true" aria-controls="paletteList" aria-autocomplete="list" />
                        <kbd>Esc</kbd>
                    </div>
                    <div class="palette-list" id="paletteList" role="listbox" aria-label="Results"></div>
                    <div class="palette-foot"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Ctrl</kbd><kbd>K</kbd> search from any page</span></div>
                </div>
            </div>
        </div>
    }

    <partial name="_Toasts" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_IdleLock" />
</body>
</html>
