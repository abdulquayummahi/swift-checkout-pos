@model SwiftCheckoutPOS.UI.Models.PageInfo
@if (Model.PageCount > 1)
{
    var prev = new Dictionary<string, string?>(Model.Route) { ["page"] = (Model.Page - 1).ToString() };
    var next = new Dictionary<string, string?>(Model.Route) { ["page"] = (Model.Page + 1).ToString() };
    <nav class="d-flex justify-content-between align-items-center px-3 py-2 border-top bg-light" aria-label="Pages">
        <span class="text-muted small">Showing @Model.First–@Model.Last of @Model.TotalItems</span>
        <div class="btn-group">
            @if (Model.Page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-action="@Model.Action" asp-all-route-data="prev">‹ Previous</a> }
            <span class="btn btn-sm btn-light disabled">Page @Model.Page of @Model.PageCount</span>
            @if (Model.Page < Model.PageCount) { <a class="btn btn-sm btn-outline-secondary" asp-action="@Model.Action" asp-all-route-data="next">Next ›</a> }
        </div>
    </nav>
}
