@{ ViewData["Title"] = "First-time setup"; }
<div class="container py-5" style="max-width: 480px;">
    <h2 class="fw-bold">Create the first Admin</h2>
    <p class="text-muted">No users exist yet. This one-time step creates the shop owner's Admin account. There is no default password.</p>
    @if (ViewBag.Error != null) { <div class="alert alert-danger fw-bold">@ViewBag.Error</div> }
    <form asp-action="Setup" method="post" class="card card-body shadow-sm border-0">
        <input name="username" class="form-control mb-2" placeholder="Username" maxlength="50" required autocomplete="off" />
        <input name="fullName" class="form-control mb-2" placeholder="Full name" maxlength="100" required />
        <input name="password" type="password" class="form-control mb-2" placeholder="Password (12+ characters)" required autocomplete="new-password" />
        <input name="confirmPassword" type="password" class="form-control mb-3" placeholder="Repeat password" required autocomplete="new-password" />
        <button class="btn btn-dark fw-bold">Create Admin</button>
    </form>
</div>
