@{
    ViewData["Title"] = "Set up the shop";
    Layout = "_AuthLayout";
}
<h1>Set up the shop</h1>
<p class="lead-text">Create the owner's Admin account. This page appears only once, while no staff account exists.</p>
@if (ViewBag.Error != null) { <div class="alert alert-danger" role="alert">@Html.Icon("circle-x") <span>@ViewBag.Error</span></div> }
<form asp-action="Setup" method="post">
    <div class="mb-3">
        <label class="form-label" for="fullName">Your full name</label>
        <input id="fullName" name="fullName" class="form-control" maxlength="100" required autocomplete="name" autofocus />
    </div>
    <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input id="username" name="username" class="form-control" maxlength="50" required autocomplete="username" />
        <div class="form-text">Used to sign in, for example "owner".</div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="pw">Password</label>
        <div class="input-group">
            <input id="pw" name="password" type="password" class="form-control" required autocomplete="new-password" minlength="12" />
            <button type="button" class="btn btn-quiet" data-reveal="pw" aria-label="Show password">@Html.Icon("eye")</button>
        </div>
        <div class="form-text">At least 12 characters, with letters and numbers. There is no default password.</div>
    </div>
    <div class="mb-4">
        <label class="form-label" for="pw2">Repeat password</label>
        <input id="pw2" name="confirmPassword" type="password" class="form-control" required autocomplete="new-password" />
    </div>
    <button class="btn btn-primary btn-lg w-100" data-busy="Creating…">Create Admin account</button>
</form>
@section Scripts { <partial name="_RevealPassword" /> }
