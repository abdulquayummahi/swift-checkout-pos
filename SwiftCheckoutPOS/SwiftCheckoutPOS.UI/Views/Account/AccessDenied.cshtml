@{
    ViewData["Title"] = "Access denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <section class="card border-0 shadow-sm text-center p-4 p-md-5">
            <div class="text-danger fs-1 mb-3" aria-hidden="true">⛔</div>
            <h1 class="h3 fw-bold">Access denied</h1>
            <p class="text-muted mb-4">Your account does not have permission to open this area.</p>
            <a class="btn btn-primary" asp-controller="Checkout" asp-action="Index">Return to checkout</a>
        </section>
    </div>
</div>
