@{
    ViewData["Title"] = "Screen locked";
    Layout = "_AuthLayout";
}
<div class="d-flex align-items-center gap-3 mb-3">
    <span class="avatar" style="width:48px;height:48px;font-size:1rem" aria-hidden="true">@UiHelpers.Initials(User.Identity?.Name)</span>
    <div>
        <h1 class="mb-0">Screen locked</h1>
        <div class="text-muted">@User.Identity?.Name</div>
    </div>
</div>
<p class="lead-text">The order on the till is kept. Enter your password to carry on.</p>
<form asp-action="Unlock" method="post">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <details class="mb-3" id="asOther">
        <summary>Unlock as a Manager or Admin</summary>
        <div class="mt-2">
            <label class="form-label" for="who">Manager or Admin username</label>
            <input id="who" name="username" class="form-control" autocomplete="off" />
        </div>
    </details>
    <div class="mb-4">
        <label class="form-label" for="pw">Password</label>
        <div class="input-group">
            <input id="pw" name="password" type="password" class="form-control form-control-lg" required autofocus autocomplete="current-password" />
            <button type="button" class="btn btn-quiet" data-reveal="pw" aria-label="Show password">@Html.Icon("eye")</button>
        </div>
    </div>
    <button class="btn btn-primary btn-lg w-100">Unlock</button>
</form>
<form asp-action="Logout" method="post" class="mt-3 text-center">
    <button class="btn btn-link">Sign out instead</button>
</form>
@section Scripts { <partial name="_RevealPassword" /> }
