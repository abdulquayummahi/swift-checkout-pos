@{ ViewData["Title"] = "Screen locked"; }
<div class="container py-5" style="max-width: 440px;">
    <h2 class="fw-bold">Screen locked</h2>
    <p class="text-muted">Locked after 15 minutes without activity. Your cart is kept. Signed in as <strong>@User.Identity?.Name</strong>.</p>
    @if (TempData["Error"] != null) { <div class="alert alert-danger fw-bold">@TempData["Error"]</div> }
    <form asp-action="Unlock" method="post" class="card card-body shadow-sm border-0">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <input name="password" type="password" class="form-control form-control-lg mb-2" placeholder="Your password" required autofocus autocomplete="current-password" />
        <details class="mb-3">
            <summary class="small">Unlock as Manager / Admin instead</summary>
            <input name="username" class="form-control mt-2" placeholder="Manager or Admin username" autocomplete="off" />
            <div class="small text-muted mt-1">Then type that person's password above.</div>
        </details>
        <button class="btn btn-dark fw-bold">Unlock</button>
    </form>
    <form asp-action="Logout" method="post" class="mt-3"><button class="btn btn-link">Sign out instead</button></form>
</div>
